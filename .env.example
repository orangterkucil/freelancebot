# ---- Copy this file to .env.local and fill in your real values ----
# .env.local is gitignored and never gets pushed to GitHub.

# Supabase (publishable key = safe in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxx

# Supabase service-role key (server-only, NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx_or_sb_secret_xxxxx

# Groq API key (for the AI agent)
GROQ_API_KEY=gsk_xxxxxxxxxxxxx

# Arc testnet RPC + chain config (from https://docs.arc.io/arc/references/rpc-endpoints)
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app

# USDC token on Arc testnet (look up in Arc docs / Circle faucet)
ARC_USDC_ADDRESS=

# Deployed contract address (filled after first deploy in week 2)
NEXT_PUBLIC_ESCROW_ADDRESS=

# Deployer private key (used by Hardhat to deploy. NEVER use a wallet with real funds.)
DEPLOYER_PRIVATE_KEY=

# Circle Developer Account email (used in submission form)
CIRCLE_DEVELOPER_EMAIL=your-email@example.com
